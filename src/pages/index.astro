---
import Layout from '../layouts/Layout.astro';
import HomeCarousel from '../components/HomeCarousel.astro';

const pageTitle = 'WUNDERBAR ESSEN – Authentische chinesische Küche & Kochkurse in Berlin';
const pageDescription = 'Entdecken Sie WUNDERBAR ESSEN in Berlin: authentische chinesische Gerichte, Dim Sum, Kochkurse, private Reservierungen und traditionelle Geschmackserlebnisse.';
const pageUrl = 'https://www.wunderbar-essen.de';
const pageImage = '/logo-text.png';
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage}>
  <main class="container">
    <section class="intro-section">
	  <HomeCarousel />
	  <div id="description">
      <h1>
        <span data-language-german>Authentische chinesische Küche</span>
        <span data-language-english>Authentic Chinese Cuisine</span>
      </h1>
      <p>
        <span data-language-german>WUNDERBAR ESSEN verbindet traditionelle chinesische Technik mit frischen Zutaten aus Berlin. Unser Menü bietet Dim Sum, Wokgerichte, vegetarische Spezialitäten und regionale Aromen aus dem Reich der Mitte.</span>
        <span data-language-english>WUNDERBAR ESSEN combines traditional Chinese techniques with fresh ingredients from Berlin. Our menu offers dim sum, wok dishes, vegetarian specialties, and regional flavors from across China.</span>
      </p>
      <p>
        <span data-language-german>Ob Familienfeier, Geschäftstermin oder private Reservierung: Bei uns entdecken Gäste die Vielfalt chinesischer Küche in entspannter Atmosphäre.</span>
        <span data-language-english>Whether you are planning a family celebration, business meeting, or private reservation, you can discover the variety of Chinese cuisine in a relaxed atmosphere.</span>
      </p>
	  </div>
    </section>

    <section class="courses-section">
      <div class="course-card">
        <div class="course-image">
          <img src="menu/66红烧茄子.jpeg" alt="Geschmorte Auberginen, authentisches chinesisches Gericht" />
          <div class="course-title"><span data-language-german>Geschmorte Auberginen</span><span data-language-english>Braised eggplant in soy sauce</span> (红烧茄子)</div>
          <div class="price"><strong><span data-language-german>€99 p.P.</span><span data-language-english>€99 per person</span></strong></div>
        </div>
        <div class="course-details">
          <h3>
          <span data-language-german>Kochkurs</span>
          <span data-language-english>Cooking Class</span>
          </h3>
          <p class="course-tagline">
          <span data-language-german>Genuss und Kultur aus China</span>
          <span data-language-english>Enjoyment and culture from China</span>
          </p>
          <p class="course-tagline"><span data-language-german>mit Renjian Zhao</span><span data-language-english>with Renjian Zhao</span></p>
          <p class="course-tagline-subtitle"><strong>
          <span data-language-german>👉 Jetzt anmelden! Begrenzt Plätze - Anmeldung erforderlich</span>
          <span data-language-english>👉 Register now! Limited places - registration required</span>
          </strong></p>

          <div class="course-info">
          <p><strong><span data-language-german>Datum:</span><span data-language-english>Date:</span></strong> <span data-language-german>18. Juli 2026</span><span data-language-english>July 18, 2026</span></p>
          <p><strong><span data-language-german>Zeit:</span><span data-language-english>Time:</span></strong> 14:00 - 17:30 <span data-language-german>Uhr</span><span data-language-english> </span></p>
          </div>

          <div class="course-contact">
          <p><strong><a href="pdf/Kochkurse_Renjian_Zhao.pdf" target="_blank" rel="noreferrer noopener"><span data-language-german>Flyer herunterladen</span><span data-language-english>Download flyer</span></a></strong></p>
          <p><strong><span data-language-german>Telefon:</span><span data-language-english>Phone:</span></strong> 03033912911</p>
          <p><strong><span data-language-german>E-Mail:</span><span data-language-english>Email:</span></strong> <a href="mailto:kochkurs.wunderbar@gmail.com">kochkurs.wunderbar@gmail.com</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section">
      <div class="info-block">
    <h2><span data-language-german>Öffnungszeiten</span><span data-language-english>Opening Hours</span></h2>
        <div class="hours">
      <p><strong><span data-language-german>Montag – Freitag</span><span data-language-english>Monday – Friday</span></strong></p>
          <p><span data-language-german>12:00 – 15:00 Uhr & 17:00 – 22:00 Uhr</span><span data-language-english>12:00 – 15:00 & 17:00 – 22:00</span></p>
        </div>
        <div class="hours">
      <p><strong><span data-language-german>Samstag & Sonntag</span><span data-language-english>Saturday & Sunday</span></strong></p>
      <p><span data-language-german>Nur private Reservierung</span><span data-language-english>Private reservations only</span></p>
        </div>
      </div>

      <div class="info-block">
    <h2><span data-language-german>Kontaktinformationen</span><span data-language-english>Contact Information</span></h2>
    <p><strong><span data-language-german>Inhaber:</span><span data-language-english>Owner:</span></strong> Renjian Zhao</p>
    <p><strong><span data-language-german>Adresse:</span><span data-language-english>Address:</span></strong> Bernhardstrasse 12, 10715 Berlin</p>
    <p><strong><span data-language-german>Telefon:</span><span data-language-english>Phone:</span></strong> 03033912911</p>
    <p><strong><span data-language-german>Mobil:</span><span data-language-english>Mobile:</span></strong> 017670981275</p>
    <p><strong><span data-language-german>Website:</span><span data-language-english>Website:</span></strong> <a href="https://www.wunderbar-essen.de/">https://www.wunderbar-essen.de/</a></p>
    <p><strong><span data-language-german>E-Mail:</span><span data-language-english>Email:</span></strong> <a href="mailto:koch@wunderbar-essen.de">koch@wunderbar-essen.de</a></p>
    <p><strong>WeChat ID:</strong> xwwilliam</p>
        <div class="map-wrapper">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2430.0455384908246!2d13.327958415805924!3d52.47831117980627!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a85063758ff469%3A0xfd08ae4e699bbc26!2sBernhardstra%C3%9Fe%2012%2C%2010715%20Berlin!5e0!3m2!1sde!2sde!4v1603617119314!5m2!1sde!2sde" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .container {
    font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(240, 240, 240, 0.98) 100%);
    min-height: 100vh;
  }

  h1 {
    text-align: center;
    color: #222;
    margin-bottom: 1rem;
    font-size: 2.5em;
    font-weight: 700;
    letter-spacing: 1px;
    border-bottom: 3px solid #d4af37;
    padding-bottom: 20px;
  }

  h2 {
    color: #222;
    border-bottom: 2px solid #d4af37;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 1.3em;
    font-weight: 600;
  }

  .intro-section {
    margin-bottom: 2rem;
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .intro-section:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    border-color: #d4af37;
    transform: translateY(-2px);
  }

  .intro-section #description {
    padding: 1.5rem 1.25rem;
    padding-top: unset;
  }

  .intro-section p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: #555;
    font-size: 1rem;
	
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-block {
    background: white;
    border: 1px solid #e0e0e0;
    margin-bottom: 0;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .info-block:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    border-color: #d4af37;
    transform: translateY(-2px);
  }

  .info-block p {
    margin: 0.75rem 0;
    line-height: 1.7;
    color: #555;
    font-size: 1em;
  }

  .info-block strong {
    color: #222;
    font-weight: 600;
  }

  .hours {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    padding-top: 1rem;
  }

  .hours:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .hours p {
    margin: 0.4rem 0;
    color: #555;
  }

  .hours p:first-child {
    font-weight: 600;
    color: #222;
    font-size: 1.05em;
  }

  a {
    color: #d4af37;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  a:hover {
    color: #222;
    text-decoration: underline;
  }

  .map-wrapper {
    border-radius: 4px;
    border: 1px solid #e0e0e0;
  }

  .courses-section {
    margin-bottom: 2em;
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .course-card {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .course-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    border-color: #d4af37;
    transform: translateY(-2px);
  }

  .course-image {
    width: 100%;
    aspect-ratio: 2 / 1;
    min-height: 250px;
    overflow: hidden;
    background: #f5f5f5;
    position: relative;
  }

  .price {
    bottom: 16px;
    right: 16px;
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    min-height: 72px;
    padding: 0.3em 0.6em;
    background: #f3e409;
    color: #222;
    font-size: 1.35em;
    font-weight: 800;
    border-radius: 50% 55% 50% 55% / 55% 45% 55% 45%;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.16);
    transform: rotate(-17deg);
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.6);
  }

  .course-title {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.55);
    font-size: 1.9em;
    font-style: italic;
    font-weight: 700;
    color: #422264;
    border-radius: 5px;
    padding: 10px;
    top: 5px;
  }

  .course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
  }

  .course-details {
    padding: 2rem;
  }

  .course-details h3 {
    color: #222;
    margin: 0 0 0.5rem 0;
    font-size: 1.5em;
    font-weight: 600;
  }

  .course-tagline,
  .course-tagline-subtitle {
    color: #666;
    font-size: 0.95em;
    margin-block-start: 0.5rem;
    margin-bottom: 0.1rem;
    font-style: italic;
  }

  .course-tagline-subtitle {
    margin-bottom: 0.5rem;
    text-decoration: green wavy underline 1px;
  }

  .course-info {
    margin-bottom: 1.5rem;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    padding: 1rem 0;
  }

  .course-info p,
  .course-contact p {
    margin: 0.5rem 0;
    color: #555;
  }
</style>
