---
import Layout from '../layouts/Layout.astro';
import PhotoModal from '../components/PhotoModal.astro';
import MenuSection from '../components/MenuSection.astro';
import type { Menu } from '../data/menu/content.config';
import { mittagsmenü } from '../data/menu/mittagsmenu';
import { gemüse } from '../data/menu/gemüse';
import { desert } from '../data/menu/desert';
import { reiseAndNudeln } from '../data/menu/reiseAndNudeln';
import { meeresfrüchte } from '../data/menu/meeresfrüchte';
import { schwein } from '../data/menu/schwein';
import { dimsum } from '../data/menu/dimsum';
import { vorspeise } from '../data/menu/vorspeise';
import { suppen } from '../data/menu/suppen';
import { huhnAndEnte } from '../data/menu/huhnAndEnte';
import { rind } from '../data/menu/rind';
import { lamm } from '../data/menu/lamm';
import { getränke } from '../data/menu/getränke';
import { bierAndWein } from '../data/menu/bierAndWein';
import { menuSectionTranslations, menuTranslations } from '../data/menu/i18n';

const pageTitle = 'WUNDERBAR ESSEN Menü – Chinesische Küche in Berlin';
const pageDescription = 'Entdecken das WUNDERBAR ESSEN Menü in Berlin: Dim Sum, Suppen, Reisgerichte, Fleischspezialitäten und Getränke für authentische chinesische Geschmackserlebnisse.';
const pageUrl = 'https://www.wunderbar-essen.de/menu';
const pageImage = '/logo-text.png';

const menuSections: { sectionId: string; items: Menu[] }[] = [
	{ sectionId: 'mittagsmenu', items: mittagsmenü },
	{ sectionId: 'gemuese', items: gemüse },
	{ sectionId: 'desert', items: desert },
	{ sectionId: 'reiseAndNudeln', items: reiseAndNudeln },
	{ sectionId: 'meeresfruechte', items: meeresfrüchte },
	{ sectionId: 'schwein', items: schwein },
	{ sectionId: 'dimsum', items: dimsum },
	{ sectionId: 'vorspeise', items: vorspeise },
	{ sectionId: 'suppen', items: suppen },
	{ sectionId: 'huhnAndEnte', items: huhnAndEnte },
	{ sectionId: 'rind', items: rind },
	{ sectionId: 'lamm', items: lamm },
	{ sectionId: 'getränke', items: getränke },
	{ sectionId: 'bierAndWein', items: bierAndWein },
];
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage}>
	<PhotoModal />
	<div id="menu-container">
		<div id="menu-header">
			<h1>
				<span data-language-german>{menuTranslations.heading.german}</span>
				<span data-language-english>{menuTranslations.heading.english}</span>
			</h1>
			<div id="filter-tags">
				{Object.entries(menuSectionTranslations).map(([sectionId, translation], index) => (
					<button class:list={['filter-tag', index === 0 && 'active']} data-category={sectionId}>
						<span data-language-german>{translation.german.title.replace(/\s*\([^)]*\)/, '')}</span>
						<span data-language-english>{translation.english.title.replace(/\s*\([^)]*\)/, '')}</span>
					</button>
				))}
			</div>
		</div>

		<div id="menu-content">
			{menuSections.map(({ sectionId, items }) => {
				const translation = menuSectionTranslations[sectionId];

				return (
					<MenuSection
						sectionId={sectionId}
						title={translation.german.title}
						titleEnglish={translation.english.title}
						subtitle={translation.german.subtitle}
						subtitleEnglish={translation.english.subtitle}
						items={items}
					/>
				);
			})}
		</div>

		<div id="menu-footer">
			
		</div>

		<button id="back-to-top" aria-label={menuTranslations.backToTop.english}>
			↑
		</button>
	</div>

	<script>
		let scrollHandler: (() => void) | null = null;

		function initMenu() {
			// Filter tag navigation
			document.querySelectorAll('.filter-tag').forEach(button => {
				button.addEventListener('click', function(this: HTMLButtonElement) {
					const category = this.getAttribute('data-category');
					
					// Update active state
					document.querySelectorAll('.filter-tag').forEach(btn => {
						btn.classList.remove('active');
					});
					this.classList.add('active');
					
					// Scroll to section
					const section = !!category && document.getElementById(category);
					if (section) {
						section.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				});
			});

			// Back to top button
			const backToTopBtn = document.getElementById('back-to-top');
			if (backToTopBtn) {
				if (scrollHandler) {
					window.removeEventListener('scroll', scrollHandler);
				}
				scrollHandler = () => {
					if (window.pageYOffset > 300) {
						backToTopBtn.classList.add('visible');
					} else {
						backToTopBtn.classList.remove('visible');
					}
				};
				window.addEventListener('scroll', scrollHandler);

				backToTopBtn.addEventListener('click', function() {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}
		}

		// Initialize on page load (initial load and client-side view transitions)
		document.addEventListener('astro:page-load', initMenu);
	</script>
</Layout>

<style>
:global([data-language-english]) {
	display: none;
}

:global(body.language-english [data-language-german]) {
	display: none;
}

:global(body.language-english [data-language-english]) {
	display: inline;
}

#menu-container {
	font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
	max-width: 1200px;
	margin: 0 auto;
	padding: 40px 20px;
	background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(240, 240, 240, 0.98) 100%);
	min-height: 100vh;
}

#menu-header {
	text-align: center;
	margin-bottom: 40px;
	border-bottom: 3px solid #d4af37;
	padding-bottom: 20px;
}

#menu-header h1 {
	margin: 0;
	font-size: 2.5em;
	color: #222;
	font-weight: 700;
	letter-spacing: 1px;
}

#menu-footer {
	text-align: center;
	padding-top: 30px;
	border-top: 2px solid #d4af37;
	color: #666;
	font-size: 0.95em;
}

#menu-footer p {
	margin: 8px 0;
}

#filter-tags {
	display: flex;
	justify-content: center;
	gap: 12px;
	margin-top: 20px;
	flex-wrap: wrap;
}

.filter-tag {
	padding: 10px 24px;
	border: 2px solid #d4af37;
	background: transparent;
	color: #d4af37;
	font-size: 1em;
	font-weight: 600;
	border-radius: 24px;
	cursor: pointer;
	transition: all 0.3s ease;
}

.filter-tag:hover {
	background: rgba(212, 175, 55, 0.1);
	transform: scale(1.05);
}

.filter-tag.active {
	background: #d4af37;
	color: white;
	box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
}

#back-to-top {
	position: fixed;
	bottom: 30px;
	right: 30px;
	width: 50px;
	height: 50px;
	background: #d4af37;
	color: white;
	border: none;
	border-radius: 50%;
	font-size: 1.5em;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	opacity: 0;
	visibility: hidden;
	transition: all 0.3s ease;
	box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
	z-index: 100;
}

#back-to-top:hover {
	background: #c99a2a;
	box-shadow: 0 6px 16px rgba(212, 175, 55, 0.4);
	transform: translateY(-3px);
}

#back-to-top.visible {
	opacity: 1;
	visibility: visible;
}

@media (max-width: 768px) {
	#menu-container {
		padding: 20px 15px;
	}

	#menu-header h1 {
		font-size: 2em;
	}
}
</style>
